pipeline{
    agent{
        label "nodejs"
    }
    stages{
        stage("Install dependencies"){
            steps{
                dir('greeting-service'){
                sh "npm ci"
                }
            }
        }

        stage("Check Style"){
            steps{
                dir('greeting-service'){
                sh "npm run lint"
                }
            }
        }

        stage("Test"){
            steps{
                dir('greeting-service'){
                sh "npm test"
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('greeting-service'){
                sh '''
                    oc project shigveR-deploy-strategies
                    oc start-build greeting-service --follow --wait
                '''
            }
            }
        }
    }
}

        // Add the "Deploy" stage here
